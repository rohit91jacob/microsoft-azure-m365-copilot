# Copy to .env and adjust. Every setting has a safe default (src/azm365/settings.py).
# Read by the Makefile. Keep comments on their own lines. Never commit .env.

# ---------------------------------------------------------------- storage
# Root for the local lake, the silver mirror, the DuckDB warehouse and dbt state.
AZM365_DATA_DIR=./data
# local   = directory tree under $AZM365_DATA_DIR/lake (default, no services)
# azurite = Azurite Blob emulator (`npx azurite`), needs AZM365_BLOB_CONNECTION_STRING
# adls    = real ADLS Gen2 through DefaultAzureCredential (managed identity / az login)
AZM365_LAKE=local
# Azurite's well-known *development* account (public, documented by Microsoft; not a secret):
# AZM365_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<the documented Azurite key>;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# Only for AZM365_LAKE=adls (no keys: RBAC "Storage Blob Data Contributor" on the account):
# AZM365_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net

# ---------------------------------------------------------------- sources
# Optional. Raises the GitHub REST rate limit from 60 to 5,000 requests/hour. Read-only,
# public-repo scope is enough. Leave unset to run anonymously.
# GITHUB_TOKEN=
AZM365_HTTP_TIMEOUT=60
# Override the source configuration (default config/sources.yml)
# AZM365_CONFIG=config/sources.yml

# ---------------------------------------------------------------- dbt
# local | ci | fabric (fabric is compile-only; see dbt/profiles.yml)
DBT_TARGET=local
AZM365_DUCKDB_MEMORY_LIMIT=2GB

# ---------------------------------------------------------------- observability
# text | json
AZM365_LOG_FORMAT=text
